[Unit]
Description=SmartYard-Server parking occupancy service
Documentation=https://github.com/rosteleset/SmartYard-Server/tree/main/install
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/rbt/server/services/parking
ExecStart=/usr/bin/node /opt/rbt/server/services/parking/index.js config.json
RestartSec=10
Restart=always
User=rbt
Group=rbt
KillMode=process
StandardOutput=append:/var/log/rbt_parking_service/parking_service.log
StandardError=append:/var/log/rbt_parking_service/parking_service.error.log
SyslogIdentifier=rbt_parking_service

[Install]
WantedBy=multi-user.target
