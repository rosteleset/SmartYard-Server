[Unit]
Description=TURN relay for virtual intercom visitors
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=turnserver
Group=turnserver
RuntimeDirectory=rbt-virtual-intercom-turn
ExecStart=/usr/bin/turnserver -c /etc/rbt-virtual-intercom/turnserver.conf --pidfile=/run/rbt-virtual-intercom-turn/turnserver.pid
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/rbt-virtual-intercom-turn

[Install]
WantedBy=multi-user.target
